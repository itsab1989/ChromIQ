# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Virtual environment
.venv/
venv/
env/

# Distribution / PyInstaller
dist/
build/
# Toolchains downloaded by native/gammap_helper/build_windows_arm64.ps1
.tools/
*.egg-info/
*.dmg
dmg_arm64/
dmg_universal/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# IDE / editor
.idea/
.vscode/
*.swp
*.swo

# App runtime output
ChromIQ/
chromiq.log*
assets/exported/

# Chart / calibration TIFFs produced by the workflow
*.tif
*.tiff
# …but the bundled prebuilt-preset charts under assets/ ARE shipped
# (each chart set lives in its own subfolder, hence the recursive **).
!assets/charts/**/*.tif
!assets/charts/**/*.tiff

# CI-generated icons (rebuilt by scripts/build_icons.py during the build)
assets/app_icon.ico

# Claude Code local settings
.claude/

# Secrets / credentials
.env
*.key
*.pem

# Local promo/marketing deliverables (not part of the app)
*.docx

# Compiled bit-exact gamut helper — built by CI (or locally) from the vendored
# Argyll sources under native/argyll/; never checked in.
/native/chromiq-gammap
/native/chromiq-gammap.exe
.bench/

# Frozen schema-1 test fixture (#127) — must override the binary ignores above
!tests/golden/project_v1/**

# Accidental test-scratch output at repo root
/dialog_out/
/dlg2/
/mxfdlg/
/mxf_*.ti3
/scratch_*.py

# Monitor (local, do not commit)
.claude/monitor_state.json
.claude/monitor_stop_blocks
.claude/settings.local.json
.agent-reports/

# Editor / merge leftovers. `patch` writes a .orig beside the file it changes,
# and a blanket `git add -A` will commit it: an 842 KB stale duplicate of
# tab_chart.py reached master this way. `native/instlib/chartread.c.orig` is
# deliberate (the Argyll baseline for our chartread fork) and is tracked, so it
# is unaffected by this rule.
*.orig
*.rej

# A Bluetooth diagnostic report is a scan of everything switched on around the
# person who ran it — their devices and their neighbours'. The script writes to
# the Desktop now, but belt and braces: never commit one from anywhere.
cr30-bluetooth-report*.txt
scripts/offscreen_font_probe/_results/
