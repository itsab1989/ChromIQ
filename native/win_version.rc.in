/* VERSIONINFO for the Windows builds of the native helpers.
 *
 * Generated by CMake (configure_file) from native/win_version.rc.in; the
 * version comes from core/version.py, the same source ChromIQWin.spec gives
 * ChromIQ.exe its VERSIONINFO from, with the same CompanyName and
 * ProductName, and a copyright line that names ArgyllCMS's author too, so
 * the helpers inside the bundle say what they are and whose they are
 * instead of carrying no metadata at all (2026-11-09). */
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     @CHROMIQ_VER_COMMA@
 PRODUCTVERSION  @CHROMIQ_VER_COMMA@
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          0x40004L
 FILETYPE        0x1L
 FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Sebastian Reiprich"
            VALUE "FileDescription",  "@CHROMIQ_RC_DESCRIPTION@"
            VALUE "FileVersion",      "@CHROMIQ_VER@"
            VALUE "InternalName",     "@CHROMIQ_RC_NAME@"
            VALUE "LegalCopyright",   "@CHROMIQ_RC_COPYRIGHT@"
            VALUE "OriginalFilename", "@CHROMIQ_RC_NAME@.exe"
            VALUE "ProductName",      "ChromIQ"
            VALUE "ProductVersion",   "@CHROMIQ_VER@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
